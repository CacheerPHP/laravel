# Cacheer Configuration
CACHEER_DEFAULT_DRIVER=file
CACHEER_CACHE_DIR=
CACHEER_COMPRESS=false
CACHEER_ENCRYPTION_KEY=

# Cacheer Monitor
CACHEER_REPORTER_ENABLED=false
CACHEER_MONITOR_EVENTS=
CACHEER_MONITOR_HOST=127.0.0.1
CACHEER_MONITOR_PORT=9966
CACHEER_MONITOR_ENDPOINT=http://127.0.0.1:9966/api/events/clear
CACHEER_MONITOR_TIMEOUT=30

# Database (for database driver)
DB_CONNECTION=sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=cacheer_db
# DB_USERNAME=root
# DB_PASSWORD=

# Redis (for redis driver)
REDIS_CLIENT=
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_NAMESPACE=

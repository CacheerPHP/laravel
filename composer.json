{
  "name": "cacheerphp/laravel",
  "description": "A Laravel cache driver backed by CacheerPHP: keep using Cache:: and get CacheerPHP's stores, failover, encryption and monitoring underneath.",
  "keywords": ["cacheer", "cacheerphp", "laravel", "cache", "cache-driver", "failover", "tiered-cache"],
  "type": "library",
  "homepage": "https://cacheerphp.com",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/CacheerPHP/cacheerphp-laravel/issues",
    "source": "https://github.com/CacheerPHP/cacheerphp-laravel",
    "docs": "https://github.com/CacheerPHP/cacheerphp-laravel#readme",
    "security": "https://github.com/CacheerPHP/cacheerphp-laravel/security/policy"
  },
  "authors": [
    {
      "name": "Silvio Silva",
      "email": "gasparsilvio7@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Cacheer\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cacheer\\Laravel\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "illuminate/cache": "^12.0|^13.0",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "silviooosilva/cacheer-php": "^6.1"
  },
  "require-dev": {
    "laravel/pint": "^1.25",
    "orchestra/testbench": "^10.0|^11.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5|^12.0",
    "predis/predis": "^2.3|^3.0",
    "rector/rector": "^2.1"
  },
  "suggest": {
    "predis/predis": "Required for the redis backend when Laravel is configured with the predis client.",
    "ext-redis": "Required for the redis backend when Laravel is configured with the phpredis client.",
    "cacheerphp/monitor": "Live dashboard for every CacheerPHP cache, with no setup."
  },
  "extra": {
    "laravel": {
      "providers": [
        "Cacheer\\Laravel\\CacheerServiceProvider"
      ]
    }
  },
  "archive": {
    "exclude": [
      "/.*",
      "/vendor",
      "/tests",
      "/composer.lock",
      "/phpstan.neon.dist",
      "/phpunit.xml",
      "/rector.php",
      "/cacheer.log",
      "/database/*.sqlite"
    ]
  },
  "scripts": {
    "test": [
      "@test:composer",
      "@test:refactor",
      "@test:lint",
      "@test:types",
      "@test:unit"
    ],
    "test:composer": "@composer validate --strict",
    "test:refactor": "rector process --dry-run",
    "test:lint": "pint --test",
    "test:types": "phpstan analyse",
    "test:unit": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

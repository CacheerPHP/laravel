{
  "name": "silviooosilva/cacheerphp-laravel",
  "description": "Laravel integration for CacheerPHP, providing service provider, facade, commands and monitor helpers.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Cacheer\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cacheer\\Laravel\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.4.0",
   "silviooosilva/cacheer-php": "^4.7 || ^5.0",
    "illuminate/support": "^10.0|^11.0",
    "illuminate/cache": "^10.0|^11.0",
    "illuminate/console": "^10.0|^11.0"
  },
  "require-dev": {
    "orchestra/testbench": "^7.0|^8.0",
    "phpunit/phpunit": "^10.0",
    "fakerphp/faker": "^1.9",
    "laravel/pint": "^1.25.0",
    "phpstan/phpstan": "^2.1.27",
    "rector/rector": "^2.1.7"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Cacheer\\Laravel\\CacheerLaravelServiceProvider"
      ],
      "aliases": {
        "Cacheer": "Cacheer\\Laravel\\Facades\\Cacheer"
      }
    }
  },
  "scripts": {
   "test": [
            "@test:refactor",
            "@test:lint",
            "@test:types",
            "@test:unit"
    ]
  },
  "minimum-stability": "stable"
}

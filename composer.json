{
  "name": "silviooosilva/cacheerphp-laravel",
  "description": "Laravel integration for CacheerPHP, providing service provider, facade, commands and monitor helpers.",
  "keywords": ["cacheer", "cacheerphp", "laravel", "laravel-package", "laravel-integration", "cache", "caching"],
  "type": "library",
  "license": "MIT",
  "version": "0.1.0",
  "authors": [
    {
      "name": "Silvio Silva",
      "email": "gasparsilvio7@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Cacheer\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cacheer\\Laravel\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3.0",
    "silviooosilva/cacheer-php": "^4.7 || ^5.0",
    "laravel/framework": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.6.0",
    "phpunit/phpunit": "^12.0",
    "fakerphp/faker": "^1.9",
    "laravel/pint": "^1.25.0",
    "phpstan/phpstan": "^2.1.27",
    "rector/rector": "^2.1.7"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Cacheer\\Laravel\\CacheerLaravelServiceProvider"
      ],
      "aliases": {
        "Cacheer": "Cacheer\\Laravel\\Facades\\Cacheer"
      }
    }
  },
  "scripts": {
    "test": [
      "@test:refactor",
      "@test:lint",
      "@test:types",
      "@test:unit"
    ],
    "test:refactor": "rector process --dry-run",
    "test:lint": "./vendor/bin/pint",
    "test:types": "phpstan analyse src tests",
    "test:unit": "phpunit"
  },
  "minimum-stability": "stable"
}

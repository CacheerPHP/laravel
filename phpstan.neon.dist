parameters:
    level: 8
    paths:
        - src
        - tests
        - database
    tmpDir: .phpstan
    ignoreErrors:
        # \Redis comes from ext-redis, which is optional (predis works too).
        -
            message: '#Redis#'
            identifier: class.notFound
            path: src/StoreFactory.php
            reportUnmatched: false
        # A custom store returning what Laravel's untyped contract allows but its
        # PHPDoc does not, to test that routing passes those results through.
        -
            identifier: method.childReturnType
            path: tests/Support/LooselyTypedStore.php

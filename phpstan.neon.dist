parameters:
    level: 8
    paths:
        - src
        - tests
        - database
    tmpDir: .phpstan
    ignoreErrors:
        # \Redis comes from ext-redis, which is optional (predis works too).
        -
            message: '#Redis#'
            identifier: class.notFound
            path: src/StoreFactory.php
            reportUnmatched: false
        # ResilientStore takes an event dispatcher from CacheerPHP 6.1; 6.0 ignores
        # the extra argument, so one call serves both versions.
        -
            message: '#ResilientStore constructor invoked with 5 parameters#'
            identifier: arguments.count
            path: src/StoreFactory.php
            reportUnmatched: false
